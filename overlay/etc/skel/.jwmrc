<?xml version="1.0"?>
<JWM>
  <RootMenu onroot="12" height="22">
    <Program label="Terminal">xterm -ls</Program>
    <Program label="NetSurf">leveos-browser</Program>
    <Program label="Firefox ESR">leveos-browser --full</Program>
    <Program label="OpenClaw (Claw edition)">xterm -e leveos claw help</Program>
    <Separator/>
