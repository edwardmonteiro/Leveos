  </RootMenu>
  <Tray x="0" y="-1" height="30">
    <TrayButton label="LeveOS">root:1</TrayButton>
    <TaskList maxwidth="260"/>
    <Clock format="%H:%M"/>
  </Tray>
  <WindowStyle>
    <Font>DejaVu Sans-10</Font>
    <Active><Text>#f3f6fa</Text><Title>#243349</Title><Outline>#526478</Outline></Active>
    <Inactive><Text>#cbd5e1</Text><Title>#192535</Title><Outline>#2d3748</Outline></Inactive>
  </WindowStyle>
  <TaskListStyle><Font>DejaVu Sans-10</Font></TaskListStyle>
  <TrayStyle><Background>#122033</Background><Foreground>#e2e8f0</Foreground></TrayStyle>
  <PopupStyle><Font>DejaVu Sans-10</Font></PopupStyle>
</JWM>
